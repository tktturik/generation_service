# Logs
LOG_LEVEL=DEBUG
LOG_FILE=app.log
LOG_TO_CONSOLE=true

# FastAPI
HOST=0.0.0.0
PORT=8000
UC_LOG_LEVEL=critical
WORKERS=4

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=generation_service

# Webhooks (тестовые значения; секреты разные, без значений по умолчанию)
PROVIDER_WEBHOOK_SECRET=provider-test-secret
PAYMENT_WEBHOOK_SECRET=payment-test-secret

# Providers
ALPHA_URL=http://providers:9000/alpha
BETA_URL=http://providers:9000/beta

# Postgres image (читает этот же файл .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=generation_service
