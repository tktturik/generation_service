# Logs
LOG_LEVEL=DEBUG
LOG_FILE=backend.log
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_ROTATION=10 MB
LOG_RETENTION=10 days
LOG_COMPRESSION=zip
LOG_LIMIT_TRACEBACK=true
LOG_MAX_FRAMES=10

# FastAPI
HOST = 0.0.0.0
PORT = 8000
UC_LOG_LEVEL = critical

# Tempo
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.monitoring.svc:4318

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_RESOURCE_ATTRIBUTES="service.namespace=demo"
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS="health, metrics"
