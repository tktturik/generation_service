# Logs
LOG_LEVEL=DEBUG
LOG_FILE=app.log
LOG_TO_CONSOLE=true

# FastAPI
HOST=0.0.0.0
PORT=8000
UC_LOG_LEVEL=critical
WORKERS=4

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=generation_service

# Postgres image (читает этот же файл .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=generation_service
